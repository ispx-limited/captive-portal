#!/usr/sbin/nft -f
# Rendered by portalctl - do not edit by hand.

# Idempotent re-apply: declare then delete so the delete never fails.
table inet captive
delete table inet captive

table inet captive {
    set whitelist_v4 {
        type ipv4_addr
        flags interval
        auto-merge
{% if config.whitelist.networks_v4 %}
        elements = { {{ config.whitelist.networks_v4 | join(", ") }} }
{% endif %}
    }

    set whitelist_v6 {
        type ipv6_addr
        flags interval
        auto-merge
{% if config.whitelist.networks_v6 %}
        elements = { {{ config.whitelist.networks_v6 | join(", ") }} }
{% endif %}
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "{{ config.interfaces.subscriber }}" ip daddr {{ config.portal.listen_ip }} return
        iifname "{{ config.interfaces.subscriber }}" ip daddr @whitelist_v4 return
        iifname "{{ config.interfaces.subscriber }}" tcp dport 80 dnat ip to {{ config.portal.listen_ip }}:80
    }

    # Walled garden: only whitelisted destinations may be forwarded.
    # Everything else from subscribers (including all HTTPS) is dropped,
    # pfSense-style; OS captive portal detection over HTTP pops the portal.
    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "{{ config.interfaces.subscriber }}" goto subscriber_forward
    }

    chain subscriber_forward {
        ct state established,related accept
        ip daddr @whitelist_v4 accept
        ip6 daddr @whitelist_v6 accept
        # Fast-fail DNS-over-TLS so strict private-DNS clients fall back to
        # plaintext DNS quickly instead of hanging.
        tcp dport 853 reject with tcp reset
        counter drop
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "{{ config.interfaces.wan }}" ip daddr @whitelist_v4 masquerade
        oifname "{{ config.interfaces.wan }}" ip6 daddr @whitelist_v6 masquerade
    }
}
